{
  "services": [
    {
      "type": "web",
      "name": "dhanvantri-healthcare-chatbot",
      "env": "docker",
      "plan": "standard",
      "dockerfilePath": "./Dockerfile.render",
      "healthCheckPath": "/api/health",
      "envVars": [
        {
          "key": "OLLAMA_BASE",
          "value": "https://api.replicate.com/v1/models"
        },
        {
          "key": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "key": "ENABLE_PRODUCTION_FEATURES",
          "value": "true"
        },
        {
          "key": "MAX_CONCURRENT_REQUESTS",
          "value": "25"
        },
        {
          "key": "ENABLE_WHISPER",
          "value": "true"
        }
      ]
    }
  ]
}