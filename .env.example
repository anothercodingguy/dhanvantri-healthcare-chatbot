# Dhanvantri Healthcare Chatbot - Environment Configuration

# =============================================================================
# CORE SERVICE CONFIGURATION
# =============================================================================

# Ollama LLM Service
OLLAMA_BASE=http://localhost:11434
MODEL_NAME=alibayram/medgemma:4b

# Whisper Speech-to-Text Service
WHISPER_BASE=http://localhost:5001

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server Configuration
PORT=8000
LOG_LEVEL=INFO

# Production Features
ENABLE_PRODUCTION_FEATURES=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Docker Configuration
COMPOSE_PROJECT_NAME=dhanvantri

# Database (if using external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dhanvantri

# Redis (if using for caching)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# API Keys (if needed for external services)
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_TRANSLATE_API_KEY=your_google_key_here

# JWT Secret (if implementing authentication)
# JWT_SECRET=your_jwt_secret_here

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry (Error Tracking)
# SENTRY_DSN=your_sentry_dsn_here

# Application Insights
# APPINSIGHTS_INSTRUMENTATIONKEY=your_key_here

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable Features
ENABLE_VOICE_FEATURES=true
ENABLE_TRANSLATION=true
ENABLE_MEDICAL_DISCLAIMER=true
ENABLE_EMERGENCY_DETECTION=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Request Limits
MAX_REQUEST_SIZE=10MB
REQUEST_TIMEOUT=30

# Concurrent Users
MAX_CONCURRENT_REQUESTS=100

# Model Configuration
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=512